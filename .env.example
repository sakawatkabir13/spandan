APP_ENV=development
APP_NAME=Spandan
APP_TIMEZONE=Asia/Dhaka
LOG_LEVEL=INFO
ENABLE_DOCS=true
FORCE_HTTPS=false
MAX_REQUEST_SIZE_BYTES=6291456

DATABASE_URL=postgresql+asyncpg://spandan:spandan@db:5432/spandan

JWT_SECRET_KEY=spandan-super-secret-jwt-key-for-development-only-change-in-prod
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
ALLOWED_HOSTS=localhost,127.0.0.1,backend

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT_SECONDS=20
GROQ_MAX_RETRIES=2

UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=5

EMERGENCY_CONTACT_NUMBER=999

# Demo accounts are for local development only.
SEED_DEMO_DATA=true
VITE_API_BASE_URL=http://localhost:8000/api/v1
