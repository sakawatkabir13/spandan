APP_ENV=development
APP_NAME=Spandan
APP_TIMEZONE=Asia/Dhaka
LOG_LEVEL=INFO
ENABLE_DOCS=true
FORCE_HTTPS=false
MAX_REQUEST_SIZE_BYTES=6291456

DATABASE_URL=postgresql+asyncpg://spandan:spandan@db:5432/spandan

JWT_SECRET_KEY=spandan-super-secret-jwt-key-for-development-only-change-in-prod
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
ALLOWED_HOSTS=localhost,127.0.0.1,backend

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT_SECONDS=20
GROQ_MAX_RETRIES=2

UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=5

EMERGENCY_CONTACT_NUMBER=999

# Local frontend configuration. Server secrets are passed only to the backend.
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Gmail registration and password-recovery delivery (app password without spaces).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=community.cuetinsights@gmail.com
SMTP_PASSWORD=
SMTP_FROM=community.cuetinsights@gmail.com
SMTP_STARTTLS=true
SMTP_SSL=false

STRIPE_MODE=test
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYMENT_CURRENCY=bdt
MFA_ENCRYPTION_KEY=
