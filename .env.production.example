POSTGRES_DB=spandan
POSTGRES_USER=spandan_app
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
DATABASE_URL=postgresql+asyncpg://spandan_app:replace-with-a-url-encoded-password@db:5432/spandan

JWT_SECRET_KEY=replace-with-at-least-32-random-characters

FRONTEND_URL=https://spandan.example.com
BACKEND_URL=https://spandan.example.com
CORS_ORIGINS=https://spandan.example.com
ALLOWED_HOSTS=spandan.example.com,backend

APP_TIMEZONE=Asia/Dhaka
LOG_LEVEL=INFO
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
WEB_CONCURRENCY=2
# Host Nginx forwards HTTPS traffic to this loopback endpoint.
HTTP_LISTEN_HOST=127.0.0.1
HTTP_LISTEN_PORT=8082
# Keep these names when upgrading an existing deployment; do not rename data volumes.
POSTGRES_VOLUME_NAME=spandan_pgdata
UPLOADS_VOLUME_NAME=spandan_backend_uploads
RUN_MIGRATIONS=true

MFA_ENCRYPTION_KEY=replace-with-a-separate-private-32-character-secret
OPERATOR_NAME=Spandan
OPERATOR_EMAIL=community.cuetinsights@gmail.com
SYMPTOM_RETENTION_DAYS=30
# Integrations become available when their private credentials are supplied.
DEMO_MODE=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=community.cuetinsights@gmail.com
SMTP_PASSWORD=
SMTP_FROM=community.cuetinsights@gmail.com
SMTP_STARTTLS=true
SMTP_SSL=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
STRIPE_MODE=test
# Use only sk_test_ / rk_test_ credentials and a test-mode webhook secret.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYMENT_CURRENCY=bdt
VIDEO_BASE_URL=
S3_BUCKET=
S3_BACKUP_BUCKET=
S3_REGION=ap-south-1
S3_ENDPOINT_URL=
S3_PUBLIC_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
BACKUP_RETENTION_DAYS=14

# Amazon Bedrock: bearer key for development/initial deployment, EC2 role thereafter.
AI_PROVIDER=bedrock
AI_ENABLED=true
AWS_REGION=us-east-1
AWS_BEARER_TOKEN_BEDROCK=
AWS_USE_INSTANCE_ROLE=false
BEDROCK_TRIAGE_MODEL=openai.gpt-oss-120b-1:0
BEDROCK_CHAT_MODEL=openai.gpt-oss-120b-1:0
AI_TIMEOUT_SECONDS=20
AI_TOTAL_TIMEOUT_SECONDS=25
CHAT_ENABLED=false
CHAT_EVALUATION_FILE=/run/chat/chat-evaluation.json
CHAT_ENCRYPTION_KEY=
CHAT_SIGNING_PRIVATE_KEY=
CHAT_MCP_URL=
CHAT_MCP_SERVICE_TOKEN=
CHAT_TLS_CA=
CHAT_TLS_CERT=
CHAT_TLS_KEY=
CHAT_TURNS_PER_MINUTE=10
CHAT_TURNS_PER_DAY=100
CHAT_MAX_TOOL_CALLS=6
CHAT_MAX_OUTPUT_TOKENS=1500
CHAT_DEADLINE_SECONDS=60
CHAT_INPUT_PRICE_PER_MILLION=0.15
CHAT_OUTPUT_PRICE_PER_MILLION=0.60
